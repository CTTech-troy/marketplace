# Public canonical site URL. Leave blank locally to keep demo pages noindex.
NEXT_PUBLIC_SITE_URL=

# Optional server-side catalog API. Must implement the API contract described in README.md.
# Example: https://api.example.com
COMMERCE_API_BASE_URL=

# Optional server-side checkout adapter. Never expose these values as NEXT_PUBLIC_* variables.
COMMERCE_CHECKOUT_API_URL=
COMMERCE_CHECKOUT_SHARED_SECRET=

# Number of product sitemap shards is determined from the catalog API total count.
# Demo mode has a small sample catalog.